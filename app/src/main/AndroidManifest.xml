<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lichess online play, the pet's API calls and Starling's sign-in/downloads. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The pet game's voice input. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Starling resolves server SRV records through the active network's DNS. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Starling's gamepad and touch-control haptics. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- WorkService keeps sign-in and downloads alive while the player leaves the game. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Starling's game folder in shared storage, so worlds and packs are
         visible in the Files app. Android 11+ grants this from Settings, which
         Starling's setup opens; older versions use the scoped permissions. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- The in-game updater hands its downloaded APK to Android's installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Starling can fall back between Vulkan and GLES. Not required: the other
         three games must stay visible on devices without Vulkan. -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x400003" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:windowSoftInputMode="adjustResize"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Theme.ArtGallery">

        <!-- The Compose launcher. Portrait, scrollable, no WebView. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- One browser game at a time, opened at its URL hash. The WebView and
             its JavaScript bridge live in this activity rather than in the
             launcher, so leaving a game disposes of it completely.

             exported=true with a single-scheme intent filter so the Lichess
             OAuth redirect can return here: the user signs in in their browser,
             Lichess redirects to com.example.artgallery://lichess/callback, and
             Android routes that VIEW intent back to this activity instead of
             creating a new one (launchMode singleTask + onNewIntent), so the
             board the user left is still on screen, now signed in.
             The filter only claims that one scheme and path; nothing else can
             navigate this activity. The scheme is the package name in reverse
             domain-notation form, which is what Lichess's OAuth endpoint
             accepts for custom-scheme redirects (it rejects anything that
             does not look like a reversed domain). -->
        <activity
            android:name=".GameWebViewActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ArtGallery">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.example.artgallery" android:host="lichess" android:path="/callback" />
            </intent-filter>
        </activity>

        <!-- Starling: the Rust game is a NativeActivity in a process of its own.
             Its event loop ends the process on exit, so keeping it out of the
             launcher's process means the other three games survive a Starling
             crash and returning to the launcher never kills the app. -->
        <activity
            android:name="io.github.juanluci.starling.LauncherActivity"
            android:exported="true"
            android:process=":launcher"
            android:taskAffinity="${applicationId}.launcher"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.starling" />
                <data android:pathPattern=".*\\..*\\.starling" />
                <data android:pathPattern=".*\\.hmod" />
                <data android:pathPattern=".*\\..*\\.hmod" />
                <data android:pathPattern=".*\\.hnmod" />
                <data android:pathPattern=".*\\..*\\.hnmod" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <activity
            android:name="io.github.juanluci.starling.GameActivity"
            android:exported="true"
            android:process=":starling"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:theme="@style/Starling.Game"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|screenLayout|fontScale|uiMode|orientation|density|screenSize|smallestScreenSize|layoutDirection|colorMode|fontWeightAdjustment|grammaticalGender">
            <meta-data android:name="android.app.lib_name" android:value="horizon_android" />
            <meta-data android:name="android.app.func_name" android:value="starling_on_create" />
        </activity>

        <activity
            android:name="io.github.juanluci.starling.DiagnosticsActivity"
            android:exported="true"
            android:process=":diagnostics"
            android:theme="@style/Starling.Game"
            android:hardwareAccelerated="false" />

        <service
            android:name="io.github.juanluci.starling.WorkService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- The diagnostic ZIP, shared through a content URI only. -->
        <provider
            android:name="io.github.juanluci.starling.UpdateProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Starling's game folder in the Files app, in a process of its own so
             a copy is not cut short when the game ends its process. -->
        <provider
            android:name="io.github.juanluci.starling.GameFolderProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:process=":documents"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

    </application>

</manifest>
