<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Horizon drives the phone vibrator for in-game events. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Pet reminders post a notification on API 33+; the vibration itself
         does not need it, so a denied permission still rings. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Alarms are cleared by a reboot and have to be put back. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Reminders must ring on the minute with the app closed and the phone
         asleep. Without an exact-alarm permission AlarmManager is free to hold
         the alarm back until the device wakes, which looks exactly like "the
         reminder only works when I open the app".

         USE_EXACT_ALARM is granted automatically at install on Android 13+;
         SCHEDULE_EXACT_ALARM covers Android 12/12L and can be re-granted from
         the pet's settings page if a device has switched it off. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Offered in settings when a phone's battery saver sleeps the app. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Lets a reminder wake the screen with its ringing screen, like an alarm,
         instead of waiting silently in the shade. Downgrades to a heads-up
         notification if the user has switched it off. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Horizon's save/export path on API 28 only; 29+ uses MediaStore/scoped
         storage and needs no permission at all. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- Horizon can fall back between Vulkan and GLES, so neither is required.
         Marking GLES 3.0 as required here would hide the whole app - chess,
         flappy, the pet - from devices that cannot run one of the four games.
         The Horizon activity checks what it needs at runtime instead. -->
    <uses-feature android:name="android.hardware.vulkan.level" android:version="1" android:required="false" />
    <uses-feature android:glEsVersion="0x00030000" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Horizon's activity is sensorLandscape, which makes the store imply a
         required landscape screen for the whole package. Marking it optional
         keeps a portrait-only device from being refused the three games that
         do not need it. -->
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.ArtGallery">

        <!-- The Compose launcher. Portrait, scrollable, no WebView. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- One browser game at a time, opened at its URL hash. The WebView and
             its JavaScript bridge live in this activity rather than in the
             launcher, so leaving a game disposes of it completely. -->
        <activity
            android:name=".GameWebViewActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:theme="@style/Theme.ArtGallery" />

        <!-- Horizon: a native Rust client, not a WebView.

             It runs in its own :horizon process for two reasons:
               1. Horizon ends its event loop with std::process::exit(0). In the
                  launcher's process that would kill the app instead of
                  returning to the Compose home screen.
               2. A native client failure (driver, OOM) then takes down only the
                  game, leaving the other three playable.

             The class name is dev.horizon.android.HorizonActivity on purpose:
             the Rust library exports its SAF callback under that exact JNI
             name. See the class comment. -->
        <activity
            android:name="dev.horizon.android.HorizonActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|density|uiMode"
            android:exported="false"
            android:process=":horizon"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.ArtGallery.Horizon"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="android.app.lib_name" android:value="horizon_android" />
        </activity>

        <!-- Lets the Files app browse Horizon's saves. The authority is
             ${applicationId}.documents, which is the string Horizon derives at
             runtime from getPackageName(), so it keeps working under this app's
             id. Pinned to :horizon so the native library never loads into the
             launcher process. -->
        <provider
            android:name="dev.horizon.android.HorizonDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS"
            android:process=":horizon">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- The screen a reminder opens when it rings. It turns the display on
             and shows over the lock screen, so a reminder cannot be missed just
             because the phone was asleep. -->
        <activity
            android:name=".ReminderRingActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:theme="@style/Theme.ArtGallery.Reminder"
            android:turnScreenOn="true" />

        <!-- Pet reminders. The alarm fires this receiver even when the app was
             never opened since boot, so it reads the reminder from preferences
             itself instead of expecting a live process. -->
        <receiver
            android:name=".ReminderAlarmReceiver"
            android:exported="false" />

        <!-- The notification's Stop action: cancels the vibration, dismisses the
             notification and forgets the reminder. -->
        <receiver
            android:name=".ReminderStopReceiver"
            android:exported="false" />

        <receiver
            android:name=".ReminderBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- The clock moved, so the next 9:00 is not the 9:00 the
                     alarm was set against. -->
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <!-- The exact-alarm permission was granted: the inexact alarms
                     that were scheduled in its absence can be replaced. -->
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
