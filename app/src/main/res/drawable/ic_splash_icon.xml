<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash icon.

    Android 12+ derives the splash screen from the app icon unless the theme
    overrides windowSplashScreenAnimatedIcon. Using the icon meant the splash
    showed the launcher artwork inside its mask, which left a white corner
    around a green square: the launcher foreground's white backing filled the
    mask while the green background layer showed at the edges.

    This drawable is the same four quadrant boxes and the triangle mark with
    no backing rectangle and no grid, so the splash shows the square icon and
    nothing else. Geometry matches the launcher artwork exactly.

    It is drawn at 108dp with the artwork at its original size rather than
    scaled to fill the canvas: a splash icon is shown as-is rather than
    masked, so the content sits centred with the system's own margin.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#EF476F"
        android:pathData="M28,22h19a6,6 0 0 1 6,6v19a6,6 0 0 1 -6,6h-19a6,6 0 0 1 -6,-6v-19a6,6 0 0 1 6,-6z" />
    <path
        android:fillColor="#FFD166"
        android:pathData="M61,22h19a6,6 0 0 1 6,6v19a6,6 0 0 1 -6,6h-19a6,6 0 0 1 -6,-6v-19a6,6 0 0 1 6,-6z" />
    <path
        android:fillColor="#06D6A0"
        android:pathData="M28,55h19a6,6 0 0 1 6,6v19a6,6 0 0 1 -6,6h-19a6,6 0 0 1 -6,-6v-19a6,6 0 0 1 6,-6z" />
    <path
        android:fillColor="#118AB2"
        android:pathData="M61,55h19a6,6 0 0 1 6,6v19a6,6 0 0 1 -6,6h-19a6,6 0 0 1 -6,-6v-19a6,6 0 0 1 6,-6z" />
    <path
        android:fillColor="#FFFFFF"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.4"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:pathData="M32,76L53.12,32L54.88,32L76,76L68.52,76L62.395,63.24L45.605,63.24L39.48,76ZM48.773,56.64L59.227,56.64L54,45.75Z" />
