<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash icon.

    Android 12+ derives the splash screen from the app icon unless the theme
    overrides windowSplashScreenAnimatedIcon. Using the icon meant the splash
    showed the launcher artwork inside its mask, which left a white corner
    around a green square: the launcher foreground's white backing filled the
    mask while the green background layer showed at the edges.

    This drawable is the four quadrant boxes and the triangle on their own,
    with no backing rectangle and no grid, so the splash shows the square icon
    and nothing else. It is drawn at 108dp with the artwork filling the canvas,
    because the splash icon is not masked the way an adaptive icon is.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#EF476F"
        android:pathData="M8,8h43a5,5 0 0 1 5,5v43a5,5 0 0 1 -5,5h-43a5,5 0 0 1 -5,-5v-43a5,5 0 0 1 5,-5z" />
    <path
        android:fillColor="#FFD166"
        android:pathData="M57,8h43a5,5 0 0 1 5,5v43a5,5 0 0 1 -5,5h-43a5,5 0 0 1 -5,-5v-43a5,5 0 0 1 5,-5z" />
    <path
        android:fillColor="#06D6A0"
        android:pathData="M8,57h43a5,5 0 0 1 5,5v43a5,5 0 0 1 -5,5h-43a5,5 0 0 1 -5,-5v-43a5,5 0 0 1 5,-5z" />
    <path
