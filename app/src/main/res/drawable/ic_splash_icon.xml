        android:pathData="M57,57h43a5,5 0 0 1 5,5v43a5,5 0 0 1 -5,5h-43a5,5 0 0 1 -5,-5v-43a5,5 0 0 1 5,-5z" />
    <path
        android:fillColor="#FFFFFF"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.6"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:pathData="M26,84L53.2,30L54.8,30L82,84L73,84L65.7,68.5L42.3,68.5L35,84ZM46.2,60.6L61.8,60.6L54,46.5Z" />
