# --- Release build artefacts ---------------------------------------------
# R8 writes the obfuscation mapping and the seeds/usage files here. They are
# build output, not source. Keep the mapping file out of git but preserve it
# for any release that ships: it is the only thing that makes a release crash
# report readable, so archive it with the artefact rather than committing it.
*.aab
*.aar
*.ap_
*.dex
mapping.txt
seeds.txt
usage.txt
configuration.txt
resources.txt
kotlin-tooling-metadata.json
*.hprof

# --- Signing material -----------------------------------------------------
# Never commit a keystore or its credentials. A real release key belongs in
# the environment, not in the repository.
*.jks
*.keystore
keystore.properties
signing.properties
release-keys/

# --- Native / generated ----------------------------------------------------
*.so
*.dylib
*.dll
obj/
out/
release/

# --- Horizon native payload ------------------------------------------------
# Staged by tools/fetch-horizon.ps1 from a hash-verified Horizon release, or
# built by tools/build-horizon.ps1. Both files are large and reproducible, so
# they stay out of git. A checkout without them still builds; the launcher
# shows Horizon as "not staged" instead of starting an activity that would
# fail on System.loadLibrary.
/app/src/main/jniLibs/
/app/src/main/assets/engine-data.zip

# --- Editors and OS --------------------------------------------------------
*.log
*.tmp
*.swp
*~
.idea/
.vscode/

# --- Local tooling ---------------------------------------------------------
/.kotlin/
node_modules/
__pycache__/

# Generated Virtual Pet 3D preview renders. Rebuild them with
# tools/pet3d/blender/preview_ortho.py; they are review artefacts, not app
# assets.
/tools/pet3d/previews/

